# GitHub webhook secret — used by PAC to validate incoming webhook payloads
GITHUB_WEBHOOK_SECRET=

# GitHub Container Registry credentials
GHCR_TOKEN=
GITHUB_USER=
GITHUB_REPO=dknhat2000/saritasa-devops-build-samples

# SSH key for git-clone task (defaults to ~/.ssh/dknhat2000_ed25519)
GIT_SSH_KEY=

# GitHub App credentials — required for PAC (see ./setup.sh pac output)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
