# Secret values for cicd provision scripts.
# Copy to secrets.env and fill in. NEVER commit secrets.env.

# GitHub username (fork owner) — used for GHCR image paths
export GITHUB_USER="your-github-username"

# GitHub Personal Access Token with write:packages and read:packages scopes
export GHCR_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"

# Shared secret for GitHub webhook validation (Tekton GitHub interceptor)
export GITHUB_WEBHOOK_SECRET="generate-a-random-string-here"
