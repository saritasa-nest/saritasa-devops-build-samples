# Non-secret configuration for cicd provision scripts.
# Copy to config.env and customize.

# Kubernetes
export CICD_NAMESPACE="cicd"
export KUBE_CONTEXT="minikube"

# Minikube resources (used when starting a new cluster)
export MINIKUBE_MEMORY="8192"
export MINIKUBE_CPUS="4"

# Tekton pinned versions
export TEKTON_PIPELINES_VERSION="v0.62.0"
export TEKTON_TRIGGERS_VERSION="v0.29.0"

# Registry (GHCR)
export REGISTRY="ghcr.io"
# GITHUB_USER is loaded from secrets.env for image naming

# Concurrency control for build PipelineRuns
export MAX_CONCURRENT_BUILDS="2"

# Pack CLI version (matches scripts/.util/tools.json)
export PACK_VERSION="0.35.1"

# Git repository defaults (override in PipelineRun params from webhook)
export GIT_REPO_URL="https://github.com/saritasa-nest/saritasa-devops-build-samples.git"

# ngrok local API
export NGROK_API_URL="http://127.0.0.1:4040"
